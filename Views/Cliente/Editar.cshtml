@model TicketSales.Models.Cliente

@{
    ViewData["Title"] = "Editar Cliente";
}

<div class="container mt-5 animate__animated animate__fadeIn">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-lg border-0 mb-4">
                <div class="card-header py-3 bg-transparent border-bottom border-secondary">
                    <h3 class="mb-0 text-warning fw-bold"><i class="fa-solid fa-user-pen me-2"></i>Editar Cliente</h3>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Editar" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="UsuarioId" />
                        <input type="hidden" asp-for="Ativo" />

                        <div class="mb-3">
                            <label class="form-label text-white fw-bold">Nome Completo</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-muted"><i class="fa-solid fa-user"></i></span>
                                <input asp-for="Nome" class="form-control" />
                            </div>
                            <span asp-validation-for="Nome" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-white fw-bold">E-mail (Login)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-muted"><i class="fa-solid fa-envelope"></i></span>
                                <input asp-for="Email" class="form-control bg-secondary text-white border-secondary" readonly />
                                <span class="input-group-text bg-dark border-secondary text-muted"><i class="fa-solid fa-lock"></i></span>
                            </div>
                            <small class="text-muted">O e-mail não pode ser alterado por aqui.</small>
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-white fw-bold">Idade</label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-muted"><i class="fa-solid fa-calendar-day"></i></span>
                                <input asp-for="Idade" type="number" class="form-control" />
                            </div>
                            <span asp-validation-for="Idade" class="text-danger small"></span>
                        </div>

                        <hr class="border-secondary my-4" />

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="fa-solid fa-arrow-left"></i> Voltar
                            </a>
                            <button type="submit" class="btn btn-warning btn-lg px-4 fw-bold text-dark">
                                <i class="fa-solid fa-floppy-disk"></i> Salvar Alterações
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card shadow-lg border-0 border-start border-info border-5" style="background-color: rgba(13, 202, 240, 0.05);">
                <div class="card-body p-4">
                    <div class="d-flex align-items-start">
                        <div class="me-3">
                            <i class="fa-solid fa-shield-halved fa-2x text-info"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h5 class="fw-bold text-white mb-2">Segurança da Conta</h5>
                            <p class="text-muted small mb-3">
                                Se o cliente esqueceu a senha, você pode resetá-la para o padrão <strong>Ticket@2025</strong>.
                            </p>

                            <form asp-action="ResetarSenha" method="post" onsubmit="return confirm('Tem certeza? A senha atual será perdida e substituída por Ticket@2025.');">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit" class="btn btn-outline-info btn-sm fw-bold">
                                    <i class="fa-solid fa-key me-2"></i> Resetar Senha Padrão
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}