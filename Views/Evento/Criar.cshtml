@model TicketSales.Models.Evento

@{
    ViewData["Title"] = "Novo Evento";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="container mt-4 animate__animated animate__fadeIn">
    <div class="card shadow-lg border-0">
        <div class="card-header py-3">
            <h3 class="mb-0 text-primary fw-bold"><i class="fa-solid fa-calendar-plus me-2"></i>Cadastrar Novo Evento</h3>
        </div>

        <div class="card-body p-4">

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fa-solid fa-circle-exclamation"></i> <strong>Atenção:</strong> Verifique os erros abaixo.
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    <div class="mt-2">@Html.ValidationSummary(false, "", new { @class = "mb-0" })</div>
                </div>
            }

            <form asp-action="Criar" method="post" enctype="multipart/form-data">
                <div class="row">

                    <div class="col-lg-6 border-end border-secondary">
                        <h5 class="text-warning mb-3"><i class="fa-solid fa-circle-info me-2"></i>Informações Básicas</h5>

                        <div class="mb-3">
                            <label asp-for="Nome" class="form-label fw-bold">Nome do Evento</label>
                            <input asp-for="Nome" class="form-control form-control-lg" placeholder="Ex: Festival de Verão 2025" />
                            <span asp-validation-for="Nome" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Categoria" class="form-label">Categoria</label>
                                <select asp-for="Categoria" class="form-select">
                                    <option value="">Selecione...</option>
                                    <option value="Show">Show</option>
                                    <option value="Música">Música</option>
                                    <option value="Teatro">Teatro</option>
                                    <option value="Stand-up">Stand-up</option>
                                    <option value="Palestra">Palestra</option>
                                    <option value="Esporte">Esporte</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Valor" class="form-label">Valor do Ingresso</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-dark text-white border-secondary">R$</span>
                                    <input asp-for="Valor" type="number" step="0.01" class="form-control" placeholder="0,00" />
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="QuantidadeLugares" class="form-label">Capacidade (Lugares)</label>
                            <input asp-for="QuantidadeLugares" type="number" class="form-control" />
                            <div class="form-text text-muted">
                                <i class="fa-solid fa-triangle-exclamation"></i> O sistema gerará automaticamente os assentos numerados.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Banner / Imagem</label>
                            <input type="file" name="foto" class="form-control" accept="image/*" />
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <h5 class="text-warning mb-3"><i class="fa-solid fa-location-dot me-2"></i>Quando e Onde?</h5>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Data e Hora</label>
                            <input asp-for="DataEvento" type="datetime-local" class="form-control" />
                            <span asp-validation-for="DataEvento" class="text-danger"></span>
                        </div>

                        <input type="hidden" id="lat" name="Latitude" value="@Model?.Latitude" />
                        <input type="hidden" id="lon" name="Longitude" value="@Model?.Longitude" />

                        <div class="mb-3">
                            <label class="form-label">Local (Nome do Estabelecimento)</label>
                            <input asp-for="Local" class="form-control" placeholder="Ex: Allianz Parque" />
                        </div>

                        <div class="mb-2">
                            <label class="form-label">Endereço (Busca Automática)</label>
                            <div class="input-group">
                                <input asp-for="Endereco" id="inputEndereco" class="form-control" placeholder="Digite rua, número e cidade..." />
                                <button type="button" class="btn btn-outline-warning" onclick="buscarEndereco()">
                                    <i class="fa-solid fa-magnifying-glass"></i>
                                </button>
                            </div>
                        </div>

                        <div class="card border border-secondary shadow-sm">
                            <div id="mapaCadastro" style="height: 250px; width: 100%; border-radius: 4px;"></div>
                        </div>
                        <small class="text-muted mt-1 text-center d-block">
                            <i class="fa-solid fa-hand-pointer"></i> Arraste o pino azul para ajustar a posição exata.
                        </small>
                    </div>
                </div>

                <hr class="my-4 border-secondary" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                        <i class="fa-solid fa-arrow-left"></i> Cancelar
                    </a>
                    <button type="submit" class="btn btn-success btn-lg px-5 text-white fw-bold">
                        <i class="fa-solid fa-check"></i> Criar Evento
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        var map;
        var marker;

        document.addEventListener("DOMContentLoaded", function() {
            var latInicial = document.getElementById('lat').value || -14.2350;
            var lonInicial = document.getElementById('lon').value || -51.9253;
            var zoomInicial = document.getElementById('lat').value ? 16 : 4;

            map = L.map('mapaCadastro').setView([latInicial, lonInicial], zoomInicial);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap'
            }).addTo(map);

            if(document.getElementById('lat').value) {
                marker = L.marker([latInicial, lonInicial], {draggable: true}).addTo(map);
                adicionarEventoDrag();
            }

            map.on('click', function(e) {
                if (marker) {
                    marker.setLatLng(e.latlng);
                } else {
                    marker = L.marker(e.latlng, {draggable: true}).addTo(map);
                    adicionarEventoDrag();
                }
                atualizarInputs(e.latlng.lat, e.latlng.lng);
            });
        });

        function adicionarEventoDrag() {
            marker.on('dragend', function(event) {
                var position = marker.getLatLng();
                atualizarInputs(position.lat, position.lng);
            });
        }

        function buscarEndereco() {
            var endereco = document.getElementById('inputEndereco').value;
            if(!endereco) return;

            var btn = document.querySelector('button[onclick="buscarEndereco()"]');
            var iconOriginal = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';
            btn.disabled = true;

            fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(endereco)}`)
                .then(response => response.json())
                .then(data => {
                    if(data.length > 0) {
                        var lat = data[0].lat;
                        var lon = data[0].lon;
                        map.setView([lat, lon], 16);

                        if(marker) {
                            marker.setLatLng([lat, lon]);
                        } else {
                            marker = L.marker([lat, lon], {draggable: true}).addTo(map);
                            adicionarEventoDrag();
                        }
                        atualizarInputs(lat, lon);
                    } else {
                        alert("Endereço não encontrado.");
                    }
                })
                .catch(err => console.error(err))
                .finally(() => {
                    btn.innerHTML = iconOriginal;
                    btn.disabled = false;
                });
        }

        function atualizarInputs(lat, lon) {
            document.getElementById('lat').value = lat;
            document.getElementById('lon').value = lon;
        }
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}