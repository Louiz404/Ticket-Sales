@model IEnumerable<TicketSales.Models.Evento>
@using System.Linq

<table class="table table-hover align-middle mb-0 text-white">
    <thead style="background-color: rgba(255,255,255,0.05); color: #aaa;">
        <tr>
            <th class="ps-4">Evento</th>
            <th>Data & Local</th>
            <th>Categoria</th>
            <th>Lotação</th>
            <th>Valor</th>
            <th>Status</th>
            <th class="text-end pe-4">Ações</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="7" class="text-center py-5 text-muted">
                    <i class="fa-regular fa-folder-open fa-3x mb-3"></i>
                    <p>Nenhum evento encontrado.</p>
                </td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                // CORREÇÃO: Cálculos feitos aqui em cima (C# puro) para não quebrar o HTML
                double ocupacao = 0;
                string corBarra = "bg-success";

                if (item.QuantidadeLugares > 0)
                {
                    ocupacao = 100 - ((double)item.LugaresDisponiveis / item.QuantidadeLugares * 100);
                    corBarra = ocupacao > 90 ? "bg-danger" : "bg-success";
                }

                <tr style="border-bottom: 1px solid #333;">
                    <td class="ps-4">
                        <div class="d-flex align-items-center">
                            @if (!string.IsNullOrEmpty(item.Imagem))
                            {
                                <img src="~/imagens/@item.Imagem" class="rounded shadow-sm me-3 border border-secondary" style="width: 50px; height: 50px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="rounded bg-dark border border-secondary text-muted d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                                    <i class="fa-solid fa-image"></i>
                                </div>
                            }
                            <span class="fw-bold text-white">@item.Nome</span>
                        </div>
                    </td>

                    <td>
                        <div class="small text-muted">
                            <i class="fa-regular fa-calendar me-1"></i> @(item.DataEvento.HasValue? item.DataEvento.Value.ToString("dd/MM/yyyy HH:mm") : "A definir")
                            <br />
                            <i class="fa-solid fa-location-dot me-1 text-danger"></i> @(item.Local ?? "Local não definido")
                        </div>
                    </td>

                    <td>
                        <span class="badge bg-dark border border-secondary text-light">@item.Categoria</span>
                    </td>

                    <td>
                        @if (item.LugaresDisponiveis == 0)
                        {
                            <span class="badge bg-danger">Esgotado</span>
                        }
                        else
                        {
                            <span class="text-muted small">@item.LugaresDisponiveis / @item.QuantidadeLugares</span>

                            <div class="progress mt-1" style="height: 4px; width: 60px; background-color: #333;">
                                <div class="progress-bar @corBarra" role="progressbar" style="width: @ocupacao.ToString("F0").Replace(",", ".")%"></div>
                            </div>
                        }
                    </td>

                    <td class="fw-bold text-warning">
                        R$ @item.Valor.ToString("N2")
                    </td>

                    <td>
                        @if (item.Ativo)
                        {
                            <span class="badge bg-success bg-opacity-25 text-success border border-success">Ativo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary border border-secondary">Inativo</span>
                        }
                    </td>

                    <td class="text-end pe-4">
                        <div class="btn-group">
                            <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Editar">
                                <i class="fa-solid fa-pen"></i>
                            </a>

                            @if (item.Ativo)
                            {
                                <form asp-action="Desativar" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Tem certeza que deseja desativar este evento? Ele sairá da loja.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger ms-1" title="Desativar">
                                        <i class="fa-solid fa-power-off"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>