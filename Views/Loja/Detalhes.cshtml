@model TicketSales.Models.Evento

@{
    ViewData["Title"] = Model.Nome;
}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="container mt-4 animate__animated animate__fadeIn">
    <div class="row">
        <div class="col-lg-4 mb-4">
            <div class="card border-0 shadow-lg">
                @if (!string.IsNullOrEmpty(Model.Imagem))
                {
                    <img src="~/imagens/@Model.Imagem" class="card-img-top" style="height: 350px; object-fit: cover;" />
                }
                <div class="card-body">
                    <h2 class="fw-bold text-white mb-1">@Model.Nome</h2>
                    <span class="badge bg-dark border border-secondary mb-3">@Model.Categoria</span>

                    <h3 class="text-warning fw-bold mb-4">R$ @Model.Valor.ToString("N2")</h3>

                    @if (TempData["Erro"] != null)
                    {
                        <div class="alert alert-danger bg-danger text-white border-0 shadow-sm">
                            <i class="fa-solid fa-circle-exclamation"></i> @TempData["Erro"]
                        </div>
                    }

                    <div class="p-3 rounded mb-3" style="background-color: #252525;">
                        <h6 class="text-muted text-uppercase small fw-bold mb-3">Localização</h6>
                        <p class="fw-bold text-white mb-1"><i class="fa-solid fa-map-pin text-danger me-2"></i> @Model.Local</p>
                        <p class="text-muted small mb-0 ms-4">@Model.Endereco</p>
                    </div>

                    <div id="map" class="rounded border border-secondary" style="height: 200px; width: 100%;"></div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-lg h-100">
                <div class="card-header py-3">
                    <h5 class="mb-0"><i class="fa-solid fa-couch text-warning me-2"></i> Selecione seus lugares</h5>
                </div>

                <div class="card-body">
                    <form asp-action="Comprar" method="post">
                        <input type="hidden" name="eventoId" value="@Model.Id" />

                        <div class="d-flex justify-content-center gap-3 mb-4">
                            <div class="d-flex align-items-center"><span class="badge bg-dark border border-success text-success me-2">●</span> Livre</div>
                            <div class="d-flex align-items-center"><span class="badge bg-dark border border-danger text-danger me-2">●</span> Ocupado</div>
                            <div class="d-flex align-items-center"><span class="badge bg-warning text-dark me-2">●</span> Selecionado</div>
                        </div>

                        <div class="d-flex flex-wrap justify-content-center gap-1 p-4 rounded mb-4"
                             style="background-color: #181818; border: 1px dashed #444; max-height: 500px; overflow-y: auto;">
                            @foreach (var assento in Model.Assentos)
                            {
                                if (assento.Ocupado)
                                {
                                    <div class="assento-box ocupado" title="Ocupado">@assento.CodigoAssento</div>
                                }
                                else
                                {
                                    <label>
                                        <input type="checkbox" name="assentosSelecionados" value="@assento.Id" class="chk-assento" />
                                        <div class="assento-box livre">@assento.CodigoAssento</div>
                                    </label>
                                }
                            }
                        </div>

                        <div class="row align-items-end">
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-muted">Como deseja pagar?</label>
                                <select name="metodoPagamento" class="form-select form-select-lg" asp-items="Html.GetEnumSelectList<TicketSales.Models.TiposDePagamento>()"></select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <button type="submit" class="btn btn-warning btn-lg w-100 fw-bold shadow-lg text-dark">
                                    Finalizar Compra <i class="fa-solid fa-arrow-right ms-2"></i>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        var enderecoEvento = "@Html.Raw(Model.Endereco)";
        var nomeLocal = "@Html.Raw(Model.Local)";
        if (enderecoEvento && enderecoEvento.length > 5) {
            var map = L.map('map').setView([-14.2350, -51.9253], 4);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap'
            }).addTo(map);

            // O código de busca Nominatim continua igual ao seu original...
            // (Omitido para economizar espaço, mas mantenha a lógica do fetch aqui)
             var urlBusca = "https://nominatim.openstreetmap.org/search?format=json&q=" + encodeURIComponent(enderecoEvento);
             fetch(urlBusca).then(r=>r.json()).then(data=>{
                 if(data.length>0){
                     var lat = data[0].lat; var lon = data[0].lon;
                     map.setView([lat, lon], 16);
                     L.marker([lat, lon]).addTo(map).bindPopup(`<b>${nomeLocal}</b>`).openPopup();
                 }
             });
        } else {
            document.getElementById('map').style.display = 'none';
        }
    });
</script>