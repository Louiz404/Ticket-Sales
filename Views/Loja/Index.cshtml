@model List<TicketSales.Models.Evento>

@{
    ViewData["Title"] = "Loja de Ingressos";
}

<div class="bg-dark text-white text-center py-5 mb-4 shadow" style="border-radius: 0 0 20px 20px;">
    <h1 class="display-5 fw-bold"><i class="fa-solid fa-music"></i> Próximos Eventos</h1>
    <p class="lead mb-4">Encontre seu próximo show, teatro ou palestra.</p>
    
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="input-group input-group-lg shadow-lg">
                    <span class="input-group-text bg-white border-0 text-muted">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>
                    
                    <input type="text" id="inputBusca" class="form-control border-0" placeholder="O que você procura? Digite nome ou local..." autocomplete="off" />
                    
                    <select id="selectCategoria" class="form-select border-0 border-start" style="max-width: 180px; background-color: #f8f9fa;">
                        <option value="">Todas</option>
                        <option value="Show">Shows</option>
                        <option value="Teatro">Teatro</option>
                        <option value="Stand-up">Stand-up</option>
                        <option value="Palestra">Palestras</option>
                        <option value="Esporte">Esportes</option>
                    </select>
                </div>
                <small class="text-white-50 mt-2 d-block">A busca é automática enquanto você digita.</small>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div id="containerEventos" class="row">
        <partial name="_ListaEventos" model="Model" />
    </div>
</div>

@section Scripts {
    <script>
        // Função principal de busca
        function atualizarLista() {
            // 1. Pega os valores dos campos
            var termo = document.getElementById('inputBusca').value;
            var categoria = document.getElementById('selectCategoria').value;

            // 2. Efeito visual de "Carregando" (deixa transparente)
            var container = document.getElementById('containerEventos');
            container.style.opacity = '0.5';
            container.style.transition = 'opacity 0.2s';

            // 3. Chama o Backend (Controller -> Service)
            // Usamos encodeURIComponent para evitar erros com espaços ou acentos na URL
            fetch(`/Loja/Filtrar?termo=${encodeURIComponent(termo)}&categoria=${encodeURIComponent(categoria)}`)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Erro na rede');
                    }
                    return response.text(); // O Controller devolve HTML puro (PartialView)
                })
                .then(html => {
                    // 4. Substitui o conteúdo antigo pelo novo filtrado
                    container.innerHTML = html;
                    container.style.opacity = '1'; // Volta ao normal
                })
                .catch(error => {
                    console.error('Erro:', error);
                    container.style.opacity = '1';
                });
        }

        // === EVENTOS QUE DISPARAM A BUSCA ===
        
        // Dispara quando o usuário solta uma tecla no campo de texto
        document.getElementById('inputBusca').addEventListener('keyup', atualizarLista);
        
        // Dispara quando o usuário muda a opção do select
        document.getElementById('selectCategoria').addEventListener('change', atualizarLista);
    </script>
}