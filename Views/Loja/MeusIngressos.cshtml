@model List<TicketSales.Models.Compra>

@{
    ViewData["Title"] = "Meus Ingressos";
}

<div class="container mt-4 animate__animated animate__fadeIn">
    <div class="d-flex align-items-center mb-4 border-bottom border-secondary pb-3">
        <h2 class="mb-0 text-white"><i class="fa-solid fa-wallet text-warning me-3"></i>Minha Carteira</h2>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 rounded shadow-sm" style="background-color: #1e1e1e; border: 1px dashed #444;">
            <i class="fa-regular fa-folder-open fa-3x text-muted mb-3"></i>
            <h4 class="text-white-50">Sua carteira está vazia.</h4>
            <p class="text-muted small">Você ainda não comprou ingressos para nenhum evento.</p>
            <a asp-controller="Loja" asp-action="Index" class="btn btn-warning mt-3 px-4 fw-bold rounded-pill">
                <i class="fa-solid fa-cart-plus me-2"></i>Ver Eventos Disponíveis
            </a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-lg-6 mb-4">
                    <div class="card h-100 shadow-sm border-0 position-relative overflow-hidden bg-dark text-white" style="border-radius: 12px;">

                        <div class="position-absolute start-0 top-0 bottom-0 bg-success" style="width: 6px;"></div>

                        <div class="card-body ps-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <small class="text-warning text-uppercase fw-bold" style="font-size: 0.7rem; letter-spacing: 1px;">Evento Confirmado</small>
                                    <h4 class="fw-bold mb-0 text-white mt-1">@item.Evento?.Nome</h4>
                                </div>
                                <span class="badge bg-success bg-opacity-25 text-success border border-success rounded-pill px-3">
                                    <i class="fa-solid fa-check me-1"></i> PAGO
                                </span>
                            </div>

                            <div class="d-flex gap-3 mb-4">
                                @if (!string.IsNullOrEmpty(item.Evento?.Imagem))
                                {
                                    <img src="~/imagens/@item.Evento.Imagem" class="rounded shadow-sm" style="width: 70px; height: 70px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="rounded bg-secondary d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
                                        <i class="fa-solid fa-music text-white-50 fa-2x"></i>
                                    </div>
                                }

                                <div class="small">
                                    <div class="text-light mb-1"><i class="fa-regular fa-calendar text-warning me-2"></i> @item.Evento?.DataEvento.Value.ToString("dd/MM/yyyy")</div>
                                    <div class="text-light mb-1"><i class="fa-regular fa-clock text-warning me-2"></i> @item.Evento?.DataEvento.Value.ToString("HH:mm")</div>
                                    <div class="text-light"><i class="fa-solid fa-location-dot text-warning me-2"></i> @item.Evento?.Local</div>
                                </div>
                            </div>

                            @if (item.AssentosSelecionados != null && item.AssentosSelecionados.Any())
                            {
                                <div class="mb-3 p-2 rounded" style="background-color: rgba(255,255,255,0.05);">
                                    <small class="text-muted d-block mb-1">Assentos Reservados:</small>
                                    @foreach (var a in item.AssentosSelecionados)
                                    {
                                        <span class="badge bg-warning text-dark me-1">@a.CodigoAssento</span>
                                    }
                                </div>
                            }

                            <hr class="border-secondary" />

                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted d-block" style="font-size: 0.75rem;">Pedido realizado em</small>
                                    <small class="text-white">@item.DataCompra.ToString("dd/MM/yyyy")</small>
                                </div>

                                <div class="d-flex gap-2">

                                    <a asp-action="DownloadTicket" asp-route-id="@item.Id" target="_blank" class="btn btn-outline-light btn-sm px-3 shadow-sm hover-scale" title="Baixar PDF">
                                        <i class="fa-solid fa-file-pdf me-1"></i> PDF
                                    </a>

                                    <button type="button"
                                            class="btn btn-warning fw-bold text-dark btn-sm px-3 shadow-sm hover-scale"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalTicket"
                                            data-id="@item.Id"
                                            data-evento="@item.Evento?.Nome"
                                            data-data="@item.Evento?.DataEvento.Value.ToString("dd/MM/yyyy HH:mm")"
                                            data-assentos="@(item.AssentosSelecionados != null ? string.Join(", ", item.AssentosSelecionados.Select(a => a.CodigoAssento)) : "Geral")">
                                        <i class="fa-solid fa-qrcode me-1"></i> Ver QR Code
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
<div class="modal fade" id="modalTicket" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg text-dark" style="background-color: #f8f9fa;">
            <div class="modal-header bg-warning border-bottom-0 text-center justify-content-center position-relative" style="border-top: 8px solid #000;">
                <h5 class="modal-title fw-bold text-uppercase text-dark"><i class="fa-solid fa-ticket"></i> Ingresso Digital</h5>
                <button type="button" class="btn-close position-absolute end-0 top-0 m-3" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-0">
                <div class="bg-white p-4 text-center border-bottom">
                    <h2 id="modalEventoNome" class="fw-bold text-uppercase mb-1 text-dark">NOME DO EVENTO</h2>
                    <p id="modalEventoData" class="text-secondary fs-5 mb-3">DATA</p>

                    <div class="bg-white p-2 d-inline-block border rounded mb-3">
                        <img id="imgQrCode" src="" class="img-fluid" style="width: 200px; height: 200px;" alt="QR Code" />
                        <div id="qrLoading" class="spinner-border text-warning" role="status" style="display:none;">
                            <span class="visually-hidden">Carregando...</span>
                        </div>
                    </div>

                    <div class="mt-2 text-dark">
                        <strong>Assentos:</strong> <span id="modalAssentos">--</span>
                    </div>

                    <div class="mt-3 text-monospace text-secondary small bg-light p-2 rounded">
                        PEDIDO #<span id="modalPedidoId">000</span> • USO PESSOAL
                    </div>
                </div>
            </div>
            <div class="modal-footer justify-content-center border-0 bg-dark">
                <button type="button" class="btn btn-light px-5 fw-bold" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var modalTicket = document.getElementById('modalTicket');

        modalTicket.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;

            var id = button.getAttribute('data-id');
            var evento = button.getAttribute('data-evento');
            var data = button.getAttribute('data-data');
            var assentos = button.getAttribute('data-assentos');

            modalTicket.querySelector('#modalEventoNome').textContent = evento;
            modalTicket.querySelector('#modalEventoData').textContent = data;
            modalTicket.querySelector('#modalAssentos').textContent = assentos;
            modalTicket.querySelector('#modalPedidoId').textContent = id;

            var img = modalTicket.querySelector('#imgQrCode');
            var loading = modalTicket.querySelector('#qrLoading');

            img.style.display = 'none';
            loading.style.display = 'inline-block';

            var urlQrCode = '@Url.Action("GerarQRCode", "Loja")?id=' + id;

            img.src = urlQrCode;

            img.onload = function() {
                loading.style.display = 'none';
                img.style.display = 'inline-block';
            };

            img.onerror = function() {
                loading.style.display = 'none';
                console.error("Erro ao carregar imagem: " + urlQrCode);
            };
        });
    </script>
}