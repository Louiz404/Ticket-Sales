@model TicketSales.Models.ViewModels.TicketPdfViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Ingresso - @Model.Compra.Evento.Nome</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/css/bootstrap.min.css">

    <style>
        @@page {
            size: A4;
            margin: 0;
        }

        body {
            font-family: 'Helvetica', Arial, sans-serif;
            background-color: #ffffff;
            padding: 0;
            margin: 0;
        }

        .page-wrapper {
            padding: 30px;
            width: 100%;
        }

        .ticket-container {
            max-width: 700px; 
            margin: 0 auto;
            border: 2px solid #000;
            border-radius: 12px;
            overflow: hidden;
            background-color: #fff;
        }

        .header {
            background-color: #000;
            color: #ffc107;
            padding: 15px; 
            text-align: center;
            border-bottom: 4px solid #ffc107;
        }

        .header h1 {
            font-size: 24px;
            margin: 0;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .content {
            padding: 20px 30px; /* Reduzido */
        }

        .event-title {
            font-size: 28px; 
            font-weight: 800;
            text-transform: uppercase;
            margin-bottom: 5px;
            line-height: 1.2;
        }

        .row-item {
            margin-bottom: 15px;
            border-bottom: 1px dashed #ddd;
            padding-bottom: 8px;
        }

        .row-item:last-child {
            border-bottom: none;
        }

        .label {
            font-size: 11px;
            color: #666;
            text-transform: uppercase;
            font-weight: 700;
            margin-bottom: 2px;
        }

        .value {
            font-size: 16px; 
            font-weight: bold;
            color: #000;
        }

        .qr-section {
            background-color: #f8f9fa;
            text-align: center;
            padding: 20px; 
            border-top: 2px dashed #000;
        }

        .footer {
            text-align: center;
            font-size: 9px;
            color: #aaa;
            margin-top: 5px;
            padding-bottom: 10px;
        }
    </style>
</head>
<body>

    <div class="page-wrapper">
        <div class="ticket-container">
            <div class="header">
                <h1>Ticket Sales</h1>
                <p style="margin:0; font-size: 12px; color: #fff; opacity: 0.8;">Comprovante Oficial de Entrada</p>
            </div>

            <div class="content">
                <div class="text-center mb-4">
                    <h2 class="event-title">@Model.Compra.Evento.Nome</h2>
                    <span class="badge badge-warning px-3 py-1">CONFIRMADO</span>
                </div>

                <div class="row row-item">
                    <div class="col-6">
                        <div class="label">Data e Hora</div>
                        <div class="value">@Model.Compra.Evento.DataEvento.Value.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <div class="col-6 text-right">
                        <div class="label">Local</div>
                        <div class="value">@Model.Compra.Evento.Local</div>
                    </div>
                </div>

                <div class="row row-item">
                    <div class="col-6">
                        <div class="label">Cliente</div>
                        <div class="value">@Model.Compra.Cliente.Nome</div>
                    </div>
                    <div class="col-6 text-right">
                        <div class="label">Pedido Nº</div>
                        <div class="value">#@Model.Compra.Id</div>
                    </div>
                </div>

                <div class="row mt-2">
                    <div class="col-12 text-center">
                        <div class="label mb-1">Assentos Selecionados</div>
                        <div class="value text-primary">
                            @if (Model.Compra.AssentosSelecionados != null && Model.Compra.AssentosSelecionados.Any())
                            {
                                @foreach (var item in Model.Compra.AssentosSelecionados)
                                {
                                    <span class="badge badge-primary border border-dark" style="font-size: 14px; margin: 2px; padding: 5px 10px;">@item.CodigoAssento</span>
                                }
                            }
                            else
                            {
                                <span>Entrada Geral / Pista</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="qr-section">
                <p class="font-weight-bold mb-3" style="font-size: 12px; letter-spacing: 1px;">APRESENTE ESTE CÓDIGO NA ENTRADA</p>

                <img src="@Model.QrCodeBase64" width="160" height="160" style="border: 4px solid #fff; padding: 5px; background: #fff; box-shadow: 0 2px 5px rgba(0,0,0,0.1);" />

                <p class="mt-2 text-muted" style="font-size: 10px;">Válido apenas para uma utilização. Proibida a revenda.</p>
            </div>
        </div>

        <div class="footer">
            Gerado em @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss") • TicketSales App
        </div>
    </div>

</body>
</html>