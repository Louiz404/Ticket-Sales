@model List<TicketSales.Models.Evento>

@if (!Model.Any())
{
    <div class="col-12 text-center py-5">
        <i class="fa-solid fa-ghost fa-3x text-muted mb-3"></i>
        <h4 class="text-muted">Nenhum evento encontrado.</h4>
    </div>
}
else
{
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4 animate__animated animate__fadeInUp">
            <div class="card h-100 hover-effect overflow-hidden">
                <div style="height: 200px; overflow: hidden; position: relative;">
                    <img src="~/imagens/@item.Imagem" class="w-100 h-100" style="object-fit: cover; transition: transform 0.5s;" alt="@item.Nome"
                         onmouseover="this.style.transform='scale(1.1)'"
                         onmouseout="this.style.transform='scale(1)'">

                    <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-3 shadow">
                        @item.Categoria
                    </span>
                </div>

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold text-white mb-3">@item.Nome</h5>

                    <div class="mb-2 text-muted small">
                        <i class="fa-solid fa-location-dot text-danger me-1"></i> @item.Local
                    </div>
                    <div class="mb-3 text-muted small">
                        <i class="fa-regular fa-calendar text-primary me-1"></i> @item.DataEvento.Value.ToString("dd/MM/yyyy • HH:mm")
                    </div>

                    <div class="mt-auto d-flex justify-content-between align-items-center border-top pt-3" style="border-color: #333 !important;">
                        <h5 class="text-warning mb-0 fw-bold">R$ @item.Valor.ToString("N2")</h5>
                        <a href="/Loja/Detalhes/@item.Id" class="btn btn-outline-light btn-sm px-4 rounded-pill">
                            Comprar
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
}