@model List<TicketSales.Models.Evento>

@if (!Model.Any())
{
    <div class="col-12 text-center py-5">
        <h4 class="text-muted">Nenhum evento encontrado. 😢</h4>
    </div>
}
else
{
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4 animate__animated animate__fadeIn">
            <div class="card h-100 shadow-sm hover-effect">
                <img src="~/imagens/@item.Imagem" class="card-img-top" style="height: 200px; object-fit: cover;" alt="@item.Nome">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="card-title fw-bold">@item.Nome</h5>
                        <span class="badge bg-warning text-dark">@item.Categoria</span>
                    </div>

                    <p class="card-text text-muted small mb-2">
                        <i class="fa-solid fa-location-dot text-danger"></i> @item.Local
                    </p>
                    <p class="card-text text-muted small">
                        <i class="fa-regular fa-calendar text-primary"></i> @item.DataEvento.Value.ToString("dd/MM/yyyy HH:mm")
                    </p>

                    <div class="mt-auto d-flex justify-content-between align-items-center">
                        <h5 class="text-success mb-0">R$ @item.Valor.ToString("N2")</h5>
                        <a href="/Loja/Detalhes/@item.Id" class="btn btn-outline-dark btn-sm">
                            Comprar <i class="fa-solid fa-cart-shopping"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
}